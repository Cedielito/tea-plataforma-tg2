{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:cov:*)",
      "Bash(npm run build:web:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./api/.env)",
      "Read(./web/.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
